# ======================================================================
# AIMotion server — configuracion.
# Copia a ".env" y completa. ".env" NUNCA se sube a git (esta en .gitignore).
# Genera los secretos con:  npm run generate-keys
# ======================================================================

NODE_ENV=development
PORT=4000

# URL(s) del frontend, separadas por coma. Se usan cookies de sesion: NO puede ser "*".
# En produccion debe ser https://
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------
# Base de datos (PostgreSQL)
#  DATABASE_URL       rol de la APLICACION (minimo privilegio: sin DDL, sin DELETE).
#                     Crealo con:  npm run setup-roles   (te muestra la URL)
#  ADMIN_DATABASE_URL conexion del DUENO de la BD; solo para migraciones y scripts.
# Inicio rapido (solo desarrollo): puedes poner la misma URL del usuario postgres en ambas,
# pero entonces RLS y el minimo privilegio NO se aplican.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://aimotion_app:genera-con-setup-roles@localhost:5432/aimotion
ADMIN_DATABASE_URL=postgresql://postgres:tu_contrasena_admin@localhost:5432/aimotion
# DB_SSL=true                      # exigir TLS hacia la base (Supabase/Neon/produccion)
# DB_SSL_REJECT_UNAUTHORIZED=true  # validar el certificado (no lo desactives en produccion)

# ---------------------------------------------------------------------
# Secretos (>= 32 caracteres, aleatorios, DISTINTOS entre si). Usa: npm run generate-keys
# ---------------------------------------------------------------------
JWT_SECRET=genera-con-npm-run-generate-keys
# Cifrado de datos sensibles (chats, contactos, tamizajes). 64 caracteres hex.
# GUARDALA tambien en un gestor de contrasenas: si se pierde, esos datos no se recuperan.
DATA_ENCRYPTION_KEY=genera-con-npm-run-generate-keys
# Rotacion: pon la clave nueva arriba y la anterior aqui (solo descifra), luego ejecuta npm run encrypt-existing
# DATA_ENCRYPTION_KEY_OLD=

# ---------------------------------------------------------------------
# HTTPS y cookies. En produccion: HTTPS obligatorio y cookies Secure automaticamente.
# ---------------------------------------------------------------------
# FORCE_HTTPS=true
# TRUST_PROXY=1                    # detras de nginx/Render/Heroku: numero de proxies de confianza
# PUBLIC_API_HOST=api.tudominio.com  # host publico para las redirecciones a https
# COOKIE_SAMESITE=Strict           # Strict (def.) o Lax. Frontend y API deben ser del mismo "sitio".
# BCRYPT_COST=12                   # minimo 12

# ---------------------------------------------------------------------
# Anti-bots (opcional): Cloudflare Turnstile. Si defines el secreto, se verifica en el servidor.
# ---------------------------------------------------------------------
# TURNSTILE_SECRET=

# ---------------------------------------------------------------------
# Notificaciones al PROFESIONAL (opcionales). Sin configurar, la alerta se registra igual.
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM="AIMotion Alertas <alertas@tudominio.com>"
ALERT_EMAIL_TO=
# Twilio (SMS al profesional), opcional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=

# ---------------------------------------------------------------------
# SMS al CONTACTO DE EMERGENCIA del usuario (sin Twilio): celular Android con la
# app "SMS Gateway for Android" (github.com/capcom6/android-sms-gateway).
#   Local: http://IP_DEL_CELULAR:8080/message     Nube: https://api.sms-gate.app/3rdparty/v1/message
# ---------------------------------------------------------------------
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=

# Diagnostico: consultas mas lentas que esto (ms) se registran como advertencia
# SLOW_QUERY_MS=200
