# ==========================================================
# AIMotion - Configuracion del servidor de alertas clinicas
# Copia este archivo como ".env" y completa con tus datos reales.
# NUNCA subas el archivo ".env" real a un repositorio publico.
# ==========================================================

# Puerto en el que corre la API
PORT=4000

# Origen permitido para CORS (URL donde corre el frontend Vite)
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------
# Base de datos (PostgreSQL)
# Recomendado para el prototipo: una instancia gratuita en Supabase o Neon.
# Si usas Postgres local: postgresql://usuario:clave@localhost:5432/aimotion
# Si tu proveedor exige SSL, agrega "?sslmode=require" al final de la URL.
# ---------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aimotion

# Secreto usado para firmar los tokens de sesion (JWT) del panel profesional.
# Genera uno robusto, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=tomas1013579959.

# ---------------------------------------------------------
# Envio de correo (Nodemailer via SMTP)
# Ejemplo con Gmail: host smtp.gmail.com, puerto 587, secure=false,
# usando una "contrasena de aplicacion" (no la contrasena normal).
# Tambien funciona con SendGrid, Outlook365, Amazon SES, etc.
# ---------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion
ALERT_EMAIL_FROM="AIMotion Alertas <tu_correo@gmail.com>"
# Puede ser una lista separada por comas: psicologo@x.com,coordinador@x.com
ALERT_EMAIL_TO=psicologo@ejemplo.com

# ---------------------------------------------------------
# Envio de SMS (Twilio) - opcional, se puede dejar vacio
# ---------------------------------------------------------
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_FROM_NUMBER=
# Puede ser una lista separada por comas
#ALERT_SMS_TO=
